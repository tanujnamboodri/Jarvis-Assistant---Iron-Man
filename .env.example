# JARVIS configuration — copy this file to `.env` and fill in what you need.
# Everything below is OPTIONAL and has a working default or graceful
# fallback. A fresh clone with an EMPTY .env still runs — you're only
# customizing here, not unlocking functionality that's otherwise blocked.
#
#   cp .env.example .env
#
# .env is in .gitignore — it will never be committed. Never paste real keys
# into .env.example itself.

# --- Model -------------------------------------------------------------
# Any model `ollama pull`-able. 3B-class models are the point of this
# project (runs on 8GB RAM, CPU-only, fully offline).
JARVIS_MODEL=llama3.2:3b

# If you've fine-tuned your own domain model, point this at it instead.
# Leave blank to just use JARVIS_MODEL for everything.
# JARVIS_FINETUNED_MODEL=jarvis

# --- Paths ---------------------------------------------------------------
# Where your research PDFs live (for research_assistant.py / RAG).
# JARVIS_PAPERS_DIR=./papers

# --- Voice ---------------------------------------------------------------
# macOS only. Run `say -v '?'` in Terminal to see installed voices.
JARVIS_SAY_VOICE=Daniel

# Whisper model size: tiny | base | small (bigger = more accurate, slower on CPU)
JARVIS_STT_MODEL=base.en

# --- Wake word -------------------------------------------------------------
# Detection sensitivity, 0.0-1.0. Lower = more sensitive (more false wakes).
# Tune this for your own room/mic/accent — there's no universal correct value.
JARVIS_WAKE_THRESHOLD=0.5

# --- Optional external APIs (all have working fallbacks if left unset) -----
# Weather works via Open-Meteo (no key needed) if this is blank.
# OPENWEATHER_API_KEY=

# News works via public RSS feeds (no key needed) if this is blank.
# NEWS_API_KEY=

# --- Optional: EMOS GoSmart / Tuya smart bulb ------------------------------
# Entirely optional. Get these via: python -m tinytuya wizard  (see README).
# BULB_ID=
# BULB_IP=
# BULB_KEY=
# BULB_VERSION=3.3

# --- Behavior flags --------------------------------------------------------
# Sleep-by-double-clap. Leave false unless you use an external mic away
# from your keyboard — on a laptop, typing reads as claps.
JARVIS_SLEEP_CLAP=false

# System-control actions are logged but not executed (safe testing mode).
JARVIS_DRY_RUN=false
